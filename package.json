{
  "name": "@cing-self/okit-cli",
  "version": "0.0.1",
  "description": "OKIT - Agent infrastructure toolkit for managing dev tools, auth, and upgrades",
  "main": "dist/main.js",
  "bin": {
    "okit": "dist/main.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "build": "tsc && npm run gen-presets && npm run copy-web && npm run build-frontend",
    "gen-presets": "node scripts/gen-presets.js",
    "copy-web": "node scripts/copy-web.js",
    "build-frontend": "cd src/web/frontend && npm install && npm run build",
    "app:dev": "npm run build && electron dist/electron/main.js",
    "app:build": "npm run build && electron-builder --mac dir",
    "app:dist": "npm run build && electron-builder --mac dmg,zip",
    "app:install": "npm run app:build && APP_PATH=$(find release -maxdepth 3 -name 'OKIT.app' -type d | head -n 1) && test -n \"$APP_PATH\" && rm -rf /Applications/OKIT.app && cp -R \"$APP_PATH\" /Applications/OKIT.app",
    "dev": "ts-node src/main.ts",
    "dev:web": "cd src/web/frontend && npm run dev",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pkg": "pkg . --out-path=bin"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "dist/**/*.html",
    "dist/**/*.css",
    "dist/**/*.yaml",
    "!dist/release",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "agent",
    "devtools",
    "installer",
    "infrastructure"
  ],
  "author": "dolphin-molt",
  "repository": {
    "type": "git",
    "url": "https://github.com/dolphin-molt/okit.git"
  },
  "license": "MIT",
  "dependencies": {
    "@github/copilot-sdk": "^1.0.9",
    "@types/express": "^5.0.6",
    "@volcengine/openapi": "^1.36.1",
    "commander": "^11.0.0",
    "execa": "^5.1.1",
    "express": "^5.2.1",
    "fs-extra": "^11.1.1",
    "js-yaml": "^4.1.1",
    "kleur": "^4.1.5",
    "ora": "^5.4.1",
    "playwright": "^1.62.1",
    "prompts": "^2.4.2",
    "typebox": "^1.3.11",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.5.0",
    "@types/prompts": "^2.4.4",
    "@types/ws": "^8.18.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^4.1.5"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "targets": [
      "node18-macos-arm64",
      "node18-macos-x64"
    ],
    "outputPath": "bin"
  },
  "build": {
    "appId": "com.dolphin.okit",
    "productName": "OKIT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/electron/main.js"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
