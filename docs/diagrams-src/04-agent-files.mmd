graph TB
    subgraph Claude["🟠 Claude Code"]
        CF["~/.claude/settings.json"]
        CF --> CE["env 块:<br/>ANTHROPIC_BASE_URL<br/>ANTHROPIC_AUTH_TOKEN<br/>ANTHROPIC_MODEL<br/>+ 3个 DEFAULT_*_MODEL"]
    end

    subgraph Codex["🔵 Codex"]
        COF1["~/.codex/auth.json"]
        COF2["~/.codex/config.toml"]
        COF1 --> COE1["OPENAI_API_KEY"]
        COF2 --> COE2["model + model_provider<br/>[model_providers.X]<br/>base_url / env_key / wire_api<br/>requires_openai_auth"]
    end

    subgraph Gemini["🟢 Gemini"]
        GF1["~/.gemini/.env"]
        GF2["~/.gemini/settings.json"]
        GF1 --> GE1["GEMINI_API_KEY<br/>GEMINI_MODEL ← 现在丢了!<br/>GOOGLE_GEMINI_BASE_URL"]
        GF2 --> GE2["security.auth.selectedType<br/>(合并 不覆盖)"]
    end

    subgraph Additive["🟣 OpenCode / OpenClaw / ZCode / Hermes"]
        AF["~/.opencode/config.json<br/>~/.openclaw/openclaw.json<br/>~/.zcode/config.json<br/>~/.hermes/config.json"]
        AF --> AE["additive 模式<br/>读-改-写<br/>只插入一个 provider key<br/>不替换其他 provider"]
    end

    style CE fill:#fff3e0
    style COE1 fill:#e3f2fd
    style COE2 fill:#e3f2fd
    style GE1 fill:#e8f5e9
    style GE2 fill:#e8f5e9
    style AE fill:#f3e5f5
